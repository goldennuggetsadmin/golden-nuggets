FROM node:20-alpine AS builder

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend ./
ENV REACT_APP_BACKEND_URL=https://web-production-1fc9d.up.railway.app
RUN npm run build

FROM node:20-alpine

WORKDIR /app
RUN npm install -g serve

COPY --from=builder /app/build /app/build

EXPOSE 3000

CMD ["sh", "-c", "serve -s /app/build -l ${PORT:-3000}"]
